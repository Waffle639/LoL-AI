# Model
MODEL_PATH=models/sgd_model.pkl
NN_MODEL_PATH=models/neural_net.pth

# API
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# App metadata
APP_NAME=LoL 2024 AI API
APP_VERSION=1.0.0

# DagsHub DVC credentials (required for docker-build)
DAGSHUB_USER=<tu_usuario_de_dagshub>
DAGSHUB_TOKEN=<tu_token_de_dagshub>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_STARTER=

# Frontend / Redirects
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite:///./lol_api.db
